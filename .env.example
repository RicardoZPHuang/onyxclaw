# Select a trusted profile from the provider configuration file.
ONYXCLAW_PROVIDER=huaweicloud-agentsphere
ONYXCLAW_PROVIDER_CONFIG=config/providers.huaweicloud-agentsphere.example.json

# Secret values referenced by config/providers.huaweicloud-agentsphere.example.json.
HUAWEICLOUD_AGENTSPHERE_E2B_API_KEY=
HUAWEICLOUD_AGENTSPHERE_MODEL_API_KEY=
HUAWEICLOUD_AGENTSPHERE_CHANNEL_SIGNING_SECRET=

# Deployment-wide optional configuration.
ARTIFACT_STORE_URL=
# Huawei CCE + AgentSphere deployment values are injected through Kubernetes
# Secrets and ConfigMaps. Do not put real values in this file.
ONYXCLAW_CLOUD_REGION=cn-south-1
ONYXCLAW_OPENCLAW_BASE_CONFIG_JSON=
ONYXCLAW_E2B_SANDBOX_URL=https://agentsphere-sandbox-gateway.example.invalid
E2B_DATA_SESSION_WAIT_SECONDS=5
