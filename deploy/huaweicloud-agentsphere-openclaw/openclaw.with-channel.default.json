{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "auth": {
      "mode": "token"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        },
        "responses": {
          "enabled": true
        }
      }
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/onyxclaw/channel"
      ]
    },
    "entries": {
      "onyxclaw": {
        "enabled": true
      }
    }
  }
}
