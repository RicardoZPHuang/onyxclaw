{
  "manifest_version": 3,
  "name": "AgentSphere Gateway Headers",
  "version": "1.1.0",
  "description": "Adds AgentSphere Sandbox routing headers to HTTPS and WebSocket requests.",
  "minimum_chrome_version": "103",
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage"
  ],
  "host_permissions": [
    "http://*.huaweicloud-agentnetwork.com/*",
    "https://*.huaweicloud-agentnetwork.com/*"
  ],
  "action": {
    "default_title": "AgentSphere Gateway Headers",
    "default_popup": "popup.html"
  }
}
