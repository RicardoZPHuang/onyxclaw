{
  "agents": {
    "defaults": {
      "model": {
        "primary": "<model-provider>/<approved-model-id>"
      },
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "<model-provider>": {
        "baseUrl": "https://<model-api-endpoint>",
        "apiKey": "__ONYXCLAW_MODEL_API_KEY__",
        "api": "openai-completions",
        "models": [
          {
            "id": "<approved-model-id>",
            "name": "<approved-model-name>"
          }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "__ONYXCLAW_OPENCLAW_GATEWAY_TOKEN__"
    }
  }
}
